# Office AI Add-in Environment Configuration
PORT=3006
NODE_ENV=development

# Set this to the deployed Express proxy URL before building the GitHub Pages frontend.
# Leave empty for local development, where Vite proxies /api to localhost:3006.
VITE_API_BASE_URL=

# Optional Default API Keys (Users can also configure these dynamically inside the Add-in Settings UI)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=

# Custom / Local Endpoint (e.g., Ollama or vLLM)
CUSTOM_BASE_URL=http://localhost:11434/v1
